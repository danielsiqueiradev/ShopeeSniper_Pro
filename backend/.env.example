DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shopeeprofit
REDIS_URL=redis://localhost:6379/0

# Shopee Open Platform v2 — https://open.shopee.com
SHOPEE_PARTNER_ID=0
SHOPEE_PARTNER_KEY=your_partner_key_here
SHOPEE_ENV=test
SHOPEE_REDIRECT_URL=http://localhost:3000/auth/callback

# Pool de proxies p/ coleta pública (opcional, recomendado em produção)
SHOPEE_PROXY_URL=

# Cookies da sua sessão logada na Shopee (DevTools > Network > header Cookie)
# Faz o collector passar como usuário real — melhor alternativa a proxy em dev
SHOPEE_COOKIES=

DEFAULT_COMMISSION_PCT=14.0
DEFAULT_FREESHIP_PCT=6.0
DEFAULT_FIXED_FEE=4.0
DEFAULT_TAX_PCT=6.0

JWT_SECRET=change-me-in-production
